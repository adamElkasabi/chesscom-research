{
  "name": "chesscom/explanation_engine/v1/feature_grade_train_item_move.proto",
  "package": "chesscom.explanation_engine.v1",
  "dependency": [
    "chesscom/chess/v1/move.proto",
    "chesscom/explanation_engine/v1/speech.proto",
    "chesscom/train/v1/train_challenge.proto",
    "chesscom/train/v1/train_move_grade.proto"
  ],
  "message_type": [
    {
      "name": "GradeTrainItemMoveRequest",
      "field": [
        {
          "name": "challenge",
          "number": 1,
          "label": "LABEL_OPTIONAL",
          "type": "TYPE_MESSAGE",
          "type_name": ".chesscom.train.v1.TrainChallenge"
        },
        {
          "name": "original_move",
          "number": 2,
          "label": "LABEL_OPTIONAL",
          "type": "TYPE_MESSAGE",
          "type_name": ".chesscom.chess.v1.Move"
        }
      ]
    },
    {
      "name": "GradeTrainItemMoveResponse",
      "field": [
        {
          "name": "grade",
          "number": 1,
          "label": "LABEL_OPTIONAL",
          "type": "TYPE_ENUM",
          "type_name": ".chesscom.train.v1.TrainMoveGrade"
        },
        {
          "name": "reply_speech",
          "number": 2,
          "label": "LABEL_OPTIONAL",
          "type": "TYPE_MESSAGE",
          "type_name": ".chesscom.explanation_engine.v1.Speech"
        }
      ]
    }
  ],
  "syntax": "proto3"
}